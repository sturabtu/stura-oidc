{
    "name": "sturabtu/stura-oidc",
    "type": "library",
    "description": "The oidc service provider package for stura services",
    "keywords": ["stura", "oidc"],
    "license": "MIT",
    "authors": [
        {
            "name": "Julius Kiekbusch",
            "email": "contact@julius-kiekbusch.de"
        }
    ],
    "require": {
        "php": "~8.5",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.0",
        "kovah/laravel-socialite-oidc": "^0.6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "StuRaBtu\\Oidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StuRaBtu\\Oidc\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StuRaBtu\\Oidc\\OidcServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
