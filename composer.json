{
    "name": "sturabtu/stura-oidc",
    "type": "library",
    "description": "The oidc service provider package for stura services",
    "keywords": ["stura", "oidc"],
    "license": "MIT",
    "authors": [
        {
            "name": "Julius Kiekbusch",
            "email": "contact@julius-kiekbusch.de"
        }
    ],
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.6.6",
        "laravel/framework": "^12.61.1",
        "laravel/socialite": "^5.27.0",
        "kovah/laravel-socialite-oidc": "^0.6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10.0",
        "laravel/pint": "^1.29.1"
    },
    "autoload": {
        "psr-4": {
            "StuRaBtu\\Oidc\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StuRaBtu\\Oidc\\OidcServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
